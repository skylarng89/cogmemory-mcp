# ==============================================================================
#                 THE ULTIMATE CLAUDECODEIGNORE CONFIGURATION
#    Tailored for Java Spring Boot, Node.js, Frontend, Terraform & Git Baseline
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. COMPREHENSIVE GITIGNORE BASELINE & TEMPORARY FILES
# ------------------------------------------------------------------------------
# OS Metadata
**/.DS_Store
**/Thumbs.db
**/Desktop.ini

# Linux System Glitch & Temporary Files
**/core.*
**/*.swp
**/*~
**/*.tmp
**/*.temp
**/tmp/
**/temp/
**/.fuse_hidden*

# Compressed Archives & Large Binaries
**/*.zip
**/*.tar
**/*.tar.gz
**/*.gz
**/*.7z
**/*.rar
**/*.iso
**/*.dmg

# Logs & Diagnostics
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# ------------------------------------------------------------------------------
# 2. JAVA & SPRING BOOT SPECIFIC
# ------------------------------------------------------------------------------
**/target/
**/build/
**/out/
**/*.class
**/*.jar
**/*.war
**/*.ear
**/*.nar
**/.gradle/
**/.mvn/
**/HS_ERR_PID*
**/.factorypath
**/.spring-boot-devtools.properties

# ------------------------------------------------------------------------------
# 3. NODE.JS & FRONTEND FRAMEWORKS (React, Vue, Vite, Next.js, Angular)
# ------------------------------------------------------------------------------
**/node_modules/
**/dist/
**/.next/
**/.nuxt/
**/.svelte-kit/
**/.docusaurus/
**/.cache/
**/.serverless/

# Ignore lockfiles to preserve context and token limits
**/package-lock.json
**/yarn.lock
**/pnpm-lock.yaml
**/bun.lockb

# Local environment secrets and overrides
**/*.local
**/*.env
**/*.env.development.local
**/*.env.test.local
**/*.env.production.local

# ------------------------------------------------------------------------------
# 4. TERRAFORM & INFRASTRUCTURE AS CODE
# ------------------------------------------------------------------------------
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfvars
**/*.tfvars.json
**/*.tfplan
**/*_override.tf
**/*_override.tf.json
**/.terraform.lock.hcl
**/.terraform.rc
**/terraform.rc

# ------------------------------------------------------------------------------
# 5. DOCKER & CONTAINERS
# ------------------------------------------------------------------------------
**/docker/volumes/
**/.docker/
**/.dockerignore

# ------------------------------------------------------------------------------
# 6. DATABASES & LOCAL DATA REPOSITORIES
# ------------------------------------------------------------------------------
**/*.sql
**/*.dump
**/*.rdb
**/data/db/
**/.h2/
**/*.db
**/*.sqlite
**/*.sqlite3

# ------------------------------------------------------------------------------
# 7. TESTING & COVERAGE FOOTPRINTS
# ------------------------------------------------------------------------------
**/coverage/
**/.nyc_output/
**/.pytest_cache/
**/htmlcov/
**/.instrumented/
**/docs/_build/
**/.doxygen/

# ------------------------------------------------------------------------------
# 8. IDE, EDITORS & TOOL-SPECIFIC METADATA
# ------------------------------------------------------------------------------
# JetBrains (IntelliJ IDEA, WebStorm, etc.)
**/.idea/
**/*.iml
**/*.iws
**/*.ipr

# Visual Studio Code
**/.vscode/*
!**/.vscode/extensions.json
!**/.vscode/launch.json

# Sublime / Eclipse / NetBeans
**/*.sublime-project
**/*.sublime-workspace
**/.metadata/
**/.classpath
**/.project
**/.settings/
**/nbproject/
