{
  "name": "cogmemory-mcp",
  "version": "0.1.0",
  "author": {
    "name": "Patrick Aziken",
    "email": "onaziken@gmail.com"
  },
  "description": "CogMemory MCP Server — Unified context subsystems for AI coding agents",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "memory",
    "knowledge-graph",
    "code-graph",
    "ai",
    "coding-agent"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cogmemory-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector npx tsx src/index.ts",
    "smoke-test": "tsx scripts/smoke-test.ts",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "ignore": "^7.0.6",
    "ts-morph": "^28.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
