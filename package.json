{
  "name": "cogmemory-mcp",
  "version": "1.9.0",
  "mcpName": "io.github.skylarng89/cogmemory-mcp",
  "author": {
    "name": "Patrick Aziken",
    "email": "onaziken@gmail.com"
  },
  "description": "CogMemory MCP Server — Unified context subsystems for AI coding agents",
  "repository": {
    "type": "git",
    "url": "https://github.com/skylarng89/cogmemory-mcp.git"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "memory",
    "knowledge-graph",
    "code-graph",
    "ai",
    "coding-agent"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cogmemory-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "prebuild": "tsx scripts/generate-version.ts && tsx scripts/sync-server-json.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector npx tsx src/index.ts",
    "smoke-test": "tsx scripts/smoke-test.ts",
    "version": "tsx scripts/generate-version.ts && tsx scripts/sync-server-json.ts",
    "prepublishOnly": "pnpm run build",
    "postbuild": "tsx scripts/copy-migrations.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "ignore": "^7.0.8",
    "tree-sitter": "^0.25.1",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "ts-morph": "^28.0.0",
    "update-notifier": "^7.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
